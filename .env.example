# ==============================================================================
# Lege - Environment Configuration
# ==============================================================================

# --- Server / API ---
PORT=8080
ENV=development
FRONTEND_URL=http://localhost:5173

# --- Neon PostgreSQL ---
# Note: Use the pooled connection string (-pooler) for serverless deployments
DATABASE_URL=postgres://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Cloudflare R2 (S3-Compatible Object Storage) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=lege-books
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# --- External LLM API ---
GEMINI_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-1.5-flash

# --- Authentication & Session ---
AUTH_SECRET=your_super_secret_session_or_jwt_key_at_least_32_chars
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
